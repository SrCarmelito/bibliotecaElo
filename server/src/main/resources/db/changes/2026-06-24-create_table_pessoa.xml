<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="create_table_pessoa" author="carmelito.benali">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onFailMessage="A tabela pessoa já existe">
            <not>
                <tableExists tableName="pessoa" />
            </not>
        </preConditions>
        <createTable tableName="pessoa">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pessoa_pk" nullable="false"/>
            </column>
            <column name="id_integration" type="BIGINT"/>
            <column type="varchar(150)" name="nome"><constraints nullable="false"/></column>
            <column type="date" name="data_nascimento"><constraints nullable="false"/></column>
            <column type="varchar(20)" name="cpf"><constraints nullable="false"/></column>
            <column type="varchar(11)" name="telefone"><constraints nullable="false"/></column>
        </createTable>
        <addUniqueConstraint tableName="pessoa" columnNames="id" constraintName="u_pessoa_id"/>
        <customChange class="com.bibliotecaelo.utils.DomainAuditColumns">
            <param name="tableName" value="pessoa"/>
        </customChange>
    </changeSet>

    <changeSet id="create_table_pessoa_aud" author="carmelito.benali">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onFailMessage="A tabela pessoa_aud já existe">
            <not>
                <tableExists tableName="pessoa_aud" />
            </not>
        </preConditions>
        <createTable tableName="pessoa_aud" >
            <column name="rev" type="BIGINT"><constraints nullable="false"/></column>
            <column name="revtype" type="numeric(10)"><constraints nullable="false"/></column>
            <column name="id" type="uuid"><constraints nullable="false"/></column>
            <column name="id_integration" type="BIGINT"/>
            <column type="varchar(150)" name="nome"><constraints nullable="false"/></column>
            <column type="date" name="data_nascimento"><constraints nullable="false"/></column>
            <column type="varchar(20)" name="cpf"><constraints nullable="false"/></column>
            <column type="varchar(11)" name="telefone"><constraints nullable="false"/></column>
        </createTable>
        <addPrimaryKey tableName="pessoa_aud" columnNames="id, rev" constraintName="pk_pessoa_aud"/>
        <addUniqueConstraint tableName="pessoa_aud" columnNames="id, rev" constraintName="u_pessoa_aud_id"/>
    </changeSet>

</databaseChangeLog>
