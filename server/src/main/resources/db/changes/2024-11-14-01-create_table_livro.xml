<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="create_table_livro" author="carmelito.benali">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onFailMessage="A tabela livro já existe">
            <not>
                <tableExists tableName="livro" />
            </not>
        </preConditions>
        <createTable tableName="livro">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="livro_pk" nullable="false"/>
            </column>
            <column name="titulo" type="varchar(1000)"><constraints nullable="false" unique="true"/></column>
            <column name="autor" type="varchar(1000)"><constraints nullable="false"/></column>
            <column name="isbn" type="varchar(13)"><constraints nullable="false" unique="true"/></column>
            <column name="data_publicacao" type="date"><constraints nullable="false"/></column>
            <column name="categoria_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="livro_cat_fk"
                             referencedTableName="categoria"
                             referencedColumnNames="id"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="livro" columnNames="id" constraintName="u_livro_id"/>
        <customChange class="com.bibliotecaelo.utils.DomainAuditColumns">
            <param name="tableName" value="livro"/>
        </customChange>
    </changeSet>

    <changeSet id="create_table_livro_aud" author="carmelito.benali">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN" onFailMessage="A tabela livro_aud já existe">
            <not>
                <tableExists tableName="livro_aud" />
            </not>
        </preConditions>
        <createTable tableName="livro_aud" >
            <column name="rev" type="BIGINT"><constraints nullable="false"/></column>
            <column name="revtype" type="numeric(10)"><constraints nullable="false"/></column>
            <column name="id" type="uuid"><constraints nullable="false"/></column>
            <column name="titulo" type="varchar(1000)"/>
            <column name="autor" type="varchar(1000)"/>
            <column name="isbn" type="varchar(13)"/>
            <column name="data_publicacao" type="datetime"/>
            <column name="categoria_id" type="uuid"/>
        </createTable>
        <addPrimaryKey tableName="livro_aud" columnNames="id, rev" constraintName="pk_livro_aud"/>
        <addUniqueConstraint tableName="livro_aud" columnNames="id, rev" constraintName="u_livro_aud_id"/>
    </changeSet>

</databaseChangeLog>
